# Dependencies
node_modules
.pnp
.pnp.js

# Build output
dist
dist-ssr

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files (keep secrets out of git; .env.example is committed)
.env
.env.*
!.env.example
# .env.production holds ONLY public keys (URL + anon key) needed by the
# production build, so it is committed on purpose. Never add secrets here.
!.env.production

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.local

# Test coverage
coverage

# TypeScript incremental build info
*.tsbuildinfo
